    corner.CornerRadius = UDim.new(0, 8)
    corner.Parent = row

    local stroke = Instance.new("UIStroke")
    stroke.Color = Colors.Border
    stroke.Thickness = 1
    stroke.Parent = row

    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(0.6, 0, 1, 0)
    label.Position = UDim2.new(0, 12, 0, 0)
    label.BackgroundTransparency = 1
    label.Text = titleLabel
    label.TextColor3 = Colors.TextMuted
    label.Font = Enum.Font.GothamMedium
    label.TextSize = 14
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.Parent = row

    local boxInput = Instance.new("TextBox")
    boxInput.Size = UDim2.new(0.28, 0, 0.6, 0)
    boxInput.Position = UDim2.new(0.7, -15, 0.2, 0)
    boxInput.BackgroundColor3 = Colors.Background
    boxInput.Text = tostring(defaultValue)
    boxInput.TextColor3 = Colors.Text
    boxInput.Font = Enum.Font.GothamBold
    boxInput.TextSize = 12
    boxInput.Parent = row

    local inCorner = Instance.new("UICorner")
    inCorner.CornerRadius = UDim.new(0, 6)
    inCorner.Parent = boxInput

    local inStroke = Instance.new("UIStroke")
    inStroke.Color = Colors.Border
    inStroke.Thickness = 1
    inStroke.Parent = boxInput

    boxInput.FocusLost:Connect(function()
        local num = tonumber(boxInput.Text)
        if num then
            local validated = callback(num)
            boxInput.Text = tostring(validated)
        else
            callback(nil)
        end
    end)
end

-- ==================== CONSTRUÇÃO DA UI ====================
local flyRow = createRow("Fly Mode", "Fly", true, function(state)
    if state then startFly() else stopFly() end
end)

createValueInputRow("Fly Speed", flySpeed, function(value)
    if value then flySpeed = math.clamp(value, 10, 5000) end
    return flySpeed
end)

local tpWalkRow = createRow("TPWalk", "TpWalk", true, function(state)
    tpWalkEnabled = state
end)

createValueInputRow("TPWalk Speed", tpWalkSpeed, function(value)
    if value then tpWalkSpeed = math.clamp(value, 10, 1000) end
    return tpWalkSpeed
end)

local noclipRow = createRow("Noclip", "Noclip", true, function(state)
    toggleNoclip(state)
end)

local infJumpRow = createRow("Infinite Jump", "InfJump", true, function(state)
    infJumpEnabled = state
end)

local espRow = createRow("ESP Premium (MD + Dist)", "ESP", true, function(state)
    espEnabled = state
    for _, data in pairs(tracked) do
        if data.billboard then data.billboard.Enabled = espEnabled end
    end
end)

local clickTpRow = createRow("Click TP (Ctrl + Clique)", "ClickTp", false, function(state)
    clickTpEnabled = state
end)

local antiAfkRow = createRow("Anti-AFK (Desconexão)", "AntiAfk", false, function(state)
    antiAfkEnabled = state
end)

createValueInputRow("Field of View (FOV)", currentFov, function(value)
    if value then 
        currentFov = math.clamp(value, 30, 120)
    end
    return currentFov
end)

-- ==================== SENSOR DE ENTRADA CONFIGURADO ====================
UIS.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end 
    
    if input.KeyCode == Keys.Fly then
        flyRow.Trigger()
    elseif input.KeyCode == Keys.TpWalk then
        tpWalkRow.Trigger()
    elseif input.KeyCode == Keys.Noclip then
        noclipRow.Trigger()
    elseif input.KeyCode == Keys.InfJump then
        infJumpRow.Trigger()
    elseif input.KeyCode == Keys.ESP then
        espRow.Trigger()
    elseif input.KeyCode == Enum.KeyCode.F8 then
        MainFrame.Visible = not MainFrame.Visible
    end

    if input.UserInputType == Enum.UserInputType.MouseButton1 and clickTpEnabled then
        if UIS:IsKeyDown(Enum.KeyCode.LeftControl) or UIS:IsKeyDown(Enum.KeyCode.RightControl) then
            local _, myRoot, _ = getLocalCharacterData()
            local mouse = LocalPlayer:GetMouse()
            if myRoot and mouse and mouse.Target then
                myRoot.CFrame = CFrame.new(mouse.Hit.X, mouse.Hit.Y + 3, mouse.Hit.Z)
            end
        end
    end
end)

UIS.JumpRequest:Connect(function()
    if infJumpEnabled then
        local _, _, myHum = getLocalCharacterData()
        if myHum then
            myHum:ChangeState(Enum.HumanoidStateType.Jumping)
        end
    end
end)
