local function updateOverlayForPlayer(player)
	if not overlayVisible or not overlayList[player] then return end
	local entry = overlayList[player]
	local char = player.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")

	if not hum then
		entry.healthLabel.Text = "0"
		return
	end

	local hp = math.floor(hum.Health)
	entry.healthLabel.Text = tostring(hp)

	local pct = hum.Health / hum.MaxHealth
	if pct > 0.5 then entry.healthLabel.TextColor3 = Color3.fromRGB(110,255,130)
	elseif pct > 0.3 then entry.healthLabel.TextColor3 = Color3.fromRGB(255,240,100)
	else entry.healthLabel.TextColor3 = Color3.fromRGB(255,90,90) end

	local md = FindPlayerMDValue(player)
	entry.mdLabel.Text = md and tostring(md.Value) or "0"

	local chi = FindPlayerStaminaValue(player)
	entry.chiLabel.Text = chi and tostring(chi.Value) or "0"

	local s2 = FindPlayerStamina2Value(player)
	entry.stamina2Label.Text = s2 and tostring(s2.Value) or "0"
end

local function toggleOverlayVisibility()
	if not overlayGui then createOverlayGui() end
	overlayVisible = not overlayVisible
	overlayGui.Enabled = overlayVisible
	print("Overlay: " .. (overlayVisible and "ON" or "OFF"))
end

-- ==================== Conexões ====================

local function onCharacterAdded(character, player)
	trackCharacter(character, player)
	if overlayVisible then
		ensureOverlayEntry(player)
		task.wait(0.1)
		updateOverlayForPlayer(player)
	end
end

local function onPlayerAdded(player)
	player.CharacterAdded:Connect(function(c) onCharacterAdded(c, player) end)
	if player.Character then onCharacterAdded(player.Character, player) end
	ensureOverlayEntry(player)
end

-- Inicialização
createOverlayGui()
overlayGui.Enabled = true

for _, p in ipairs(Players:GetPlayers()) do
	onPlayerAdded(p)
end

Players.PlayerAdded:Connect(onPlayerAdded)
Players.PlayerRemoving:Connect(function(p)
	removeOverlayEntry(p)
	if p.Character then untrackCharacter(p.Character) end
end)

UserInputService.InputBegan:Connect(function(input, gpe)
	if gpe or debounce then return end
	if input.KeyCode == TOGGLE_KEY_ESP then
		debounce = true
		toggleEspVisibility()
		task.delay(DEBOUNCE_TIME, function() debounce = false end)
	elseif input.KeyCode == TOGGLE_KEY_OVERLAY then
		debounce = true
		toggleOverlayVisibility()
		task.delay(DEBOUNCE_TIME, function() debounce = false end)
	end
end)

RunService.Heartbeat:Connect(function()
	if overlayVisible and overlayGui and overlayGui.Enabled then
		for player in pairs(overlayList) do
			updateOverlayForPlayer(player)
		end
	end
end)

