    statusIndicator.BackgroundColor3 = Color3.fromRGB(239, 68, 68)
    statusIndicator.BorderSizePixel = 0
    statusIndicator.Parent = toggleBtn
    
    local indCorner = Instance.new("UICorner")
    indCorner.CornerRadius = UDim.new(1, 0)
    indCorner.Parent = statusIndicator

    local function action(forcedState)
        state = (forcedState ~= nil) and forcedState or (not state)
        if state then
            toggleBtn.TextColor3 = Colors.Text
            statusIndicator.BackgroundColor3 = Color3.fromRGB(34, 197, 94)
            rowStroke.Color = Colors.AccentDim
        else
            toggleBtn.TextColor3 = Colors.TextMuted
            statusIndicator.BackgroundColor3 = Color3.fromRGB(239, 68, 68)
            rowStroke.Color = Colors.Border
        end
        callback(state)
    end

    toggleBtn.MouseButton1Click:Connect(function() action() end)

    if hasKeybind then
        local bindBtn = Instance.new("TextButton")
        bindBtn.Size = UDim2.new(0.28, 0, 0.6, 0)
        bindBtn.Position = UDim2.new(0.7, -15, 0.2, 0)
        bindBtn.BackgroundColor3 = Colors.Background
        bindBtn.Text = Keys[keyConfigName].Name
        bindBtn.TextColor3 = Colors.Accent
        bindBtn.Font = Enum.Font.GothamBold
        bindBtn.TextSize = 12
        bindBtn.Parent = rowFrame

        local bindCorner = Instance.new("UICorner")
        bindCorner.CornerRadius = UDim.new(0, 6)
        bindCorner.Parent = bindBtn
        
        local bindStroke = Instance.new("UIStroke")
        bindStroke.Color = Colors.Border
        bindStroke.Thickness = 1
        bindStroke.Parent = bindBtn

        bindBtn.MouseButton1Click:Connect(function()
            if isBinding then return end
            isBinding = true
            bindBtn.Text = "..."
            bindBtn.TextColor3 = Colors.TextMuted
            
            local connection
            connection = UIS.InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.Keyboard then
                    Keys[keyConfigName] = input.KeyCode
                    bindBtn.Text = input.KeyCode.Name
                    bindBtn.TextColor3 = Colors.Accent
                    isBinding = false
                    connection:Disconnect()
                end
            end)
        end)
    end

    return { Trigger = action }
end

