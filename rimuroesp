-- ==================== Funções do Overlay (mantidas) ====================

local function FindPlayerMDValue(player)
	local char = player.Character
	if not char then return nil end
	local combat = char:FindFirstChild("combat")
	if combat then
		local md = combat:FindFirstChild("mode")
		if md and (md:IsA("IntValue") or md:IsA("NumberValue") or md:IsA("IntConstrainedValue")) then
			return md
		end
	end
	return nil
end

local function FindPlayerStaminaValue(player)
	local char = player.Character
	if not char then return nil end
	local combat = char:FindFirstChild("combat")
	if combat then
		local s = combat:FindFirstChild("stamina")
		if s and (s:IsA("IntValue") or s:IsA("NumberValue") or s:IsA("IntConstrainedValue")) then return s end
	end
	return nil
end

local function FindPlayerStamina2Value(player)
	local char = player.Character
	if not char then return nil end
	local combat = char:FindFirstChild("combat")
	if combat then
		local s2 = combat:FindFirstChild("stamina2")
		if s2 and (s2:IsA("IntValue") or s2:IsA("NumberValue") or s2:IsA("IntConstrainedValue")) then return s2 end
	end
	return nil
end

local function removeOverlayEntry(player)
	if overlayList[player] and overlayList[player].entry then
		overlayList[player].entry:Destroy()
		overlayList[player] = nil
	end
end

local function reorganizeOverlayEntries()
	local content = overlayGui and overlayGui:FindFirstChild("OverlayFrame") and overlayGui.OverlayFrame:FindFirstChild("Content")
	if not content then return end
	local idx = 0
	for _, v in pairs(overlayList) do
		if v.entry and v.entry.Parent then
			idx += 1
			v.entry.Position = UDim2.new(0, 0, 0, (idx-1)*26)
		end
	end
end

